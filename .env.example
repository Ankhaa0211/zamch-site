# Админ (хоосон байж болно — дараа нь бөглөнө)
# Сервер асахад энэ утсаар admin хэрэглэгч үүснэ/шинэчилнэ
ADMIN_PHONE=
ADMIN_PASSWORD=
# --- Brand (CarHub) ---
BRAND_NAME=CarHub
BRAND_TAGLINE=дугуй · обуд
BRAND_TITLE=CarHub — Дугуй, обуд
ADMIN_NAME=CarHub Админ
SESSION_SECRET=replace-with-a-long-random-secret
ENVIRONMENT=development
AUTO_CREATE_SCHEMA=1
TOKEN_TTL_DAYS=30
ORDER_CONFIRM_MINUTES=30

# Local default: sqlite:///./database.db
# Production (Railway Postgres): postgresql://... — app автоматаар postgresql+psycopg:// болгоно
DATABASE_URL=sqlite:///./database.db

# Seller app API access. Production дээр "*" хориотой — тодорхой origin таслалаар.
# Mobile APK CORS ашиглахгүй; web preview байвал localhost нэмнэ.
CORS_ORIGINS=http://localhost:8081

# Public URL (QPay callback + absolute media). Railway дараа: https://YOUR-SERVICE.up.railway.app
BASE_URL=http://127.0.0.1:8000
QPAY_CALLBACK_BASE=http://127.0.0.1:8000

# --- QPay merchant (QPay-ээс авна) ---
# Гурав хоёулаа бөглөгдсөн + QPAY_MOCK биш үед live горим.
# Хоосон үед автоматаар mock (туршилтын төлбөр) ажиллана.
QPAY_BASE_URL=https://merchant.qpay.mn
# Sandbox туршилт: https://merchant-sandbox.qpay.mn
QPAY_USERNAME=
QPAY_PASSWORD=
QPAY_INVOICE_CODE=
# QPAY_MOCK=1

# --- eBarimt 3.0 (QPay merchant дээр идэвхжүүлсний дараа) ---
EBARIMT_ENABLED=1
EBARIMT_TAX_TYPE=1
EBARIMT_DISTRICT_CODE=34
EBARIMT_CLASSIFICATION_CODE=
EBARIMT_TAX_PRODUCT_CODE=

# --- Delivery (холболт бэлэн — credential/URL ирэхэд тавина) ---
# Active provider: manual | own_app | partner
DELIVERY_PROVIDER=manual

# CarHub own delivery app (ирээдүй) — URL байхгүй бол job зөвхөн queue-д үлдэнэ
OWN_APP_WEBHOOK_URL=
OWN_APP_API_KEY=

# Гадны delivery компани (Plan B)
DELIVERY_PARTNER_NAME=partner
DELIVERY_PARTNER_API_URL=
DELIVERY_PARTNER_API_KEY=

# Provider → marketplace статус webhook secret (production дээр солино!)
DELIVERY_WEBHOOK_SECRET=zamch-delivery-dev-secret

# --- SMS OTP (дэлгүүрийн утас баталгаажуулалт) ---
# mock: серверийн консолд код хэвлэнэ + API debug_code буцаана
SMS_PROVIDER=mock
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=CARHUB

# --- Local demo data ---
# Хоосон DB-д туршилтын дэлгүүр/бараа:
#   python3 seed_demo.py
# эсвэл сервер асахад (дэлгүүр 0 үед): SEED_DEMO_ON_BOOT=1
# Seller demo: 99001100 / demo1234
SEED_DEMO_ON_BOOT=1

# =============================================================================
# Render production — жишээ (carhub.mn domain авсны дараа CORS/BASE_URL шинэчилнэ)
# =============================================================================
# ENVIRONMENT=production
# AUTO_CREATE_SCHEMA=0
# SESSION_SECRET=<openssl rand -hex 32>
# DATABASE_URL=<postgres-url>
# BASE_URL=https://YOUR-SERVICE.onrender.com
# QPAY_CALLBACK_BASE=https://YOUR-SERVICE.onrender.com
# CORS_ORIGINS=https://YOUR-SERVICE.onrender.com,http://localhost:8081
# BRAND_NAME=CarHub
# DELIVERY_WEBHOOK_SECRET=<random>
