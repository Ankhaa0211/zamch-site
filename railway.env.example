# Copy these into Railway → Service → Variables
# Replace YOUR-SERVICE with the generated public domain (after Networking is enabled).

ENVIRONMENT=production
AUTO_CREATE_SCHEMA=0
SESSION_SECRET=
DATABASE_URL=${{Postgres.DATABASE_URL}}
BASE_URL=https://YOUR-SERVICE.up.railway.app
QPAY_CALLBACK_BASE=https://YOUR-SERVICE.up.railway.app
CORS_ORIGINS=https://YOUR-SERVICE.up.railway.app,http://localhost:8081
TOKEN_TTL_DAYS=30
ORDER_CONFIRM_MINUTES=30
SMS_PROVIDER=mock
DELIVERY_PROVIDER=manual
DELIVERY_WEBHOOK_SECRET=
